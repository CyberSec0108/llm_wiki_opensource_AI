# LLM Wiki 설정 — 이 파일 하나가 정본이다.
# 이건 견본이다. `.env` 로 복사해서 쓴다 — 그 파일은 커밋되지 않는다.

# 제공자: openrouter | anthropic
LLM_PROVIDER=openrouter

# 모델. OpenRouter는 키 하나로 여러 모델을 쓴다.
# 인제스트 1건 = 호출 2회 (입력 약 22K · 출력 약 6.5K). 실측 가격 기준:
#   z-ai/glm-5.3-flash          $0.003/건   1.31M 컨텍스트  ← 기본
#   google/gemini-3.7-flash     $0.041/건   품질이 아쉬우면 여기로
#   anthropic/claude-sonnet-4.5 $0.164/건   어려운 논문용
# 전부 structured outputs 지원 — JSON 형식은 강제되므로 파싱은 안 깨진다.
# 목록·최신 가격: https://openrouter.ai/models
LLM_MODEL=anthropic/claude-sonnet-4.5

# 한 번에 받을 최대 출력 토큰
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0

# ── 키 ── 쓰는 제공자의 것만 채우면 된다
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
