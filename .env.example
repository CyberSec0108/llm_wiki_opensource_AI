# LLM Wiki 설정 — 이 파일 하나가 정본이다.
# 이건 견본이다. `.env` 로 복사해서 쓴다 — 그 파일은 커밋되지 않는다.

# 제공자: openrouter | anthropic
LLM_PROVIDER=openrouter

# 모델. OpenRouter는 키 하나로 여러 모델을 쓴다.
# 인제스트 1건 실측 (glm-5.3-flash, 논문 1건):
#   입력 43K · 출력 17K · $0.0074 · 약 5분
#   추론 모델은 추론 토큰이 출력에 포함된다. 그래서 max_tokens 를 넉넉히 준다.
#   z-ai/glm-5.3-flash          $0.007/건   1.31M 컨텍스트  ← 기본 (실측 통과)
#   google/gemini-3.7-flash     ~$0.09/건   품질이 아쉬우면 여기로
#   anthropic/claude-sonnet-4.5 ~$0.35/건   어려운 논문용
# 반드시 structured outputs(json_schema) 지원 모델을 써라 —
# 스키마 없이 부르면 이 모델은 YAML을 뱉는다. 실측으로 확인했다.
# 목록·최신 가격: https://openrouter.ai/models
LLM_MODEL=anthropic/claude-sonnet-4.5

# 한 번에 받을 최대 출력 토큰
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0

# 한 번의 호출을 기다릴 최대 초. 넘으면 실패로 처리한다
LLM_TIMEOUT=300
# 추론 모델이 답을 쓰기 전에 얼마나 오래 "생각"할지.
#   low | medium | high | none(생각 끄기)
# 실측: 기본값에서 첫 답변 토큰까지 47초 걸렸다(청크 1,437개가 전부 생각).
# low 로 시작한다. 답변 품질이 아쉬우면 medium 으로 올려라.
LLM_REASONING=low

# 첫 토큰을 이만큼 기다려도 안 오면 실패로 처리한다.
# 스트리밍 응답은 연결이 열려 있는 한 SDK 타임아웃이 안 걸려서 필요하다.
LLM_FIRST_TOKEN_TIMEOUT=180


# ── 키 ── 쓰는 제공자의 것만 채우면 된다
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
