{
	"schemaVersion": "0.1.0",
	"name": "raw · 인박스 (분류 보류)",
	"behavior": "create",
	"noteContentFormat": "## 내가 표시한 부분\n\n{{highlights|map: item => item.text|join:\"\\n\\n\"}}\n\n---\n\n## 원문\n\n{{content}}",
	"properties": [
		{
			"name": "type",
			"value": "unsorted",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "collected",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "why",
			"value": "",
			"type": "text"
		},
		{
			"name": "ingested",
			"value": "false",
			"type": "checkbox"
		},
		{
			"name": "tags",
			"value": "raw/inbox",
			"type": "multitext"
		}
	],
	"triggers": [],
	"noteNameFormat": "{{title}}",
	"path": "raw/inbox"
}
